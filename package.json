{
  "name": "capital-ai",
  "private": true,
  "version": "0.8.0-alpha.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host=127.0.0.1",
    "test:navigation": "node --import tsx --test scripts/navigation.test.mjs",
    "test": "node --import tsx scripts/validate-contract-suites.mjs && node --import tsx --test src/contracts/__tests__/analysisFoundation.test.ts src/contracts/__tests__/marketDataRightsEligibility.test.ts src/platform/Documentary/__tests__/documentaryProjection.test.ts && node --import tsx scripts/generate-documentary.mjs --check",
    "documentary:generate": "node --import tsx scripts/generate-documentary.mjs --write",
    "documentary:check": "node --import tsx scripts/generate-documentary.mjs --check",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:security": "node --test server/market.test.mjs server/security.test.mjs server/auth.test.mjs server/research-pages.test.mjs scripts/validate-oidc-positive-cycles.test.mjs && node --import tsx --test scripts/frontend-security.test.mjs",
    "verify:browser": "node scripts/verify-browser-boundary.mjs",
    "test:market": "node --test server/market.test.mjs server/market-contracts.test.mjs",
    "test:market:integration": "node --test server/infrastructure.integration.test.mjs",
    "test:market:local": "node scripts/test-market-infrastructure-local.mjs",
    "preflight": "node scripts/preflight.mjs",
    "preflight:full": "node scripts/preflight.mjs --full",
    "license:report": "node scripts/license-engine.mjs",
    "test:licenses": "node --test scripts/license-engine.test.mjs scripts/license-evidence.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^18.0.4",
    "express": "^4.21.2",
    "jose": "6.2.12",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "redis": "6.2.1",
    "spdx-expression-parse": "5.0.0",
    "spdx-license-ids": "3.0.23",
    "vite": "^8.3.0",
    "zod": "^4.6.5",
    "nodemailer": "10.0.13"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
