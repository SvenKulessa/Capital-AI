FROM hadolint/hadolint:v2.15.1-alpine@sha256:a1d49ae1a4e83c1dbad26b8c1ad7588c8bd1e04f4866b34ad3cac50335198552 AS hadolint
FROM aquasec/trivy:0.76.1@sha256:790fd66d1697395d8693d1acaa1ea702406a20f109b6fc7bac8db623eca6c06c
COPY --from=hadolint /bin/hadolint /usr/local/bin/hadolint
ENV TRIVY_CACHE_DIR=/tmp/trivy \
    TRIVY_SKIP_DB_UPDATE=false
USER 1000:1000
# Tooling image is normally short-lived; the healthcheck validates the scanner binary
# if the image is ever kept alive by a runner or debugging environment.
HEALTHCHECK --interval=60s --timeout=5s --retries=1 CMD ["trivy", "--version"]
ENTRYPOINT ["trivy"]
