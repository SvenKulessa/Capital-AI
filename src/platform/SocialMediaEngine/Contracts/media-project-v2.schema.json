{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capital-ai.online/schemas/media-project-v2.schema.json",
  "title": "CAPITAL-AI MediaProject v2",
  "description": "Structural schema for the canonical editable/renderable CAPITAL-AI MediaProject contract. Semantic invariants are enforced by validateMediaProjectV2().",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "slug", "title", "timebase", "canvas", "durationFrames", "tracks", "assets", "transitions", "renderRecipe", "source", "disclosure"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "projectId": { "$ref": "#/$defs/id" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "contentPackageId": { "$ref": "#/$defs/id" },
    "timebase": { "$ref": "#/$defs/rationalRate" },
    "canvas": { "$ref": "#/$defs/canvas" },
    "durationFrames": { "type": "integer", "minimum": 1 },
    "tracks": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/track" } },
    "assets": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/asset" } },
    "transitions": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/transition" } },
    "renderRecipe": { "$ref": "#/$defs/renderRecipe" },
    "source": { "$ref": "#/$defs/source" },
    "disclosure": { "$ref": "#/$defs/disclosure" },
    "metadata": { "$ref": "#/$defs/metadata" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "sha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "metadata": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } },
    "jsonValue": {
      "oneOf": [
        { "type": ["string", "number", "boolean", "null"] },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    },
    "rationalRate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 1, "maximum": 240000 },
        "denominator": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "aspectRatio"],
      "properties": {
        "width": { "type": "integer", "minimum": 64, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 64, "maximum": 8192 },
        "aspectRatio": { "enum": ["16:9", "1:1", "9:16", "custom"] },
        "pixelAspectRatio": { "$ref": "#/$defs/rationalRate" }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startFrame", "durationFrames"],
      "properties": {
        "startFrame": { "type": "integer", "minimum": 0 },
        "durationFrames": { "type": "integer", "minimum": 1 }
      }
    },
    "layerBase": {
      "type": "object",
      "required": ["id", "kind", "range", "enabled"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["scene", "text", "shape", "image", "chart", "audio", "caption"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "range": { "$ref": "#/$defs/range" },
        "enabled": { "type": "boolean" },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "sceneLayer": {
      "allOf": [
        { "$ref": "#/$defs/layerBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "range", "enabled", "title", "body"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "kind": { "const": "scene" },
            "name": { "type": "string", "minLength": 1, "maxLength": 240 },
            "range": { "$ref": "#/$defs/range" },
            "enabled": { "type": "boolean" },
            "metadata": { "$ref": "#/$defs/metadata" },
            "title": { "type": "string", "minLength": 1, "maxLength": 200 },
            "body": { "type": "string", "minLength": 1, "maxLength": 4000 },
            "kicker": { "type": "string", "minLength": 1, "maxLength": 120 },
            "disclaimer": { "type": "string", "minLength": 1, "maxLength": 500 },
            "sourceSceneRef": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        }
      ]
    },
    "textLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "range", "enabled", "text", "role"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "kind": { "const": "text" }, "name": { "type": "string", "minLength": 1, "maxLength": 240 }, "range": { "$ref": "#/$defs/range" }, "enabled": { "type": "boolean" }, "metadata": { "$ref": "#/$defs/metadata" },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 }, "role": { "enum": ["headline", "body", "label", "disclaimer", "caption"] }
      }
    },
    "shapeLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "range", "enabled", "shape"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "kind": { "const": "shape" }, "name": { "type": "string", "minLength": 1, "maxLength": 240 }, "range": { "$ref": "#/$defs/range" }, "enabled": { "type": "boolean" }, "metadata": { "$ref": "#/$defs/metadata" },
        "shape": { "enum": ["rectangle", "circle", "line", "network-node", "network-edge"] }
      }
    },
    "imageLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "range", "enabled", "assetRefId", "fit"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "kind": { "const": "image" }, "name": { "type": "string", "minLength": 1, "maxLength": 240 }, "range": { "$ref": "#/$defs/range" }, "enabled": { "type": "boolean" }, "metadata": { "$ref": "#/$defs/metadata" },
        "assetRefId": { "$ref": "#/$defs/id" }, "fit": { "enum": ["contain", "cover", "fill"] }
      }
    },
    "chartLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "range", "enabled", "chartType", "dataRef", "deterministicLabels"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "kind": { "const": "chart" }, "name": { "type": "string", "minLength": 1, "maxLength": 240 }, "range": { "$ref": "#/$defs/range" }, "enabled": { "type": "boolean" }, "metadata": { "$ref": "#/$defs/metadata" },
        "chartType": { "enum": ["line", "bar", "area", "scatter", "gauge"] }, "dataRef": { "type": "string", "minLength": 1, "maxLength": 512 }, "deterministicLabels": { "const": true }
      }
    },
    "audioLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "range", "enabled", "assetRefId", "role"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "kind": { "const": "audio" }, "name": { "type": "string", "minLength": 1, "maxLength": 240 }, "range": { "$ref": "#/$defs/range" }, "enabled": { "type": "boolean" }, "metadata": { "$ref": "#/$defs/metadata" },
        "assetRefId": { "$ref": "#/$defs/id" }, "role": { "enum": ["voiceover", "music", "effect"] }, "gainDb": { "type": "number", "minimum": -96, "maximum": 24 }
      }
    },
    "captionLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "range", "enabled", "text", "language"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "kind": { "const": "caption" }, "name": { "type": "string", "minLength": 1, "maxLength": 240 }, "range": { "$ref": "#/$defs/range" }, "enabled": { "type": "boolean" }, "metadata": { "$ref": "#/$defs/metadata" },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 }, "language": { "enum": ["de", "en"] }
      }
    },
    "layer": { "oneOf": [{ "$ref": "#/$defs/sceneLayer" }, { "$ref": "#/$defs/textLayer" }, { "$ref": "#/$defs/shapeLayer" }, { "$ref": "#/$defs/imageLayer" }, { "$ref": "#/$defs/chartLayer" }, { "$ref": "#/$defs/audioLayer" }, { "$ref": "#/$defs/captionLayer" }] },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "enabled", "layers"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["video", "graphics", "text", "chart", "audio", "caption"] }, "name": { "type": "string", "minLength": 1, "maxLength": 240 }, "enabled": { "type": "boolean" }, "layers": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/layer" } }, "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "sourceType", "reference"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["image", "audio", "video"] }, "sourceType": { "enum": ["local-file", "asset-registry", "generated"] }, "reference": { "type": "string", "minLength": 1, "maxLength": 512 }, "sha256": { "$ref": "#/$defs/sha256" }, "mimeType": { "type": "string", "minLength": 3, "maxLength": 128 }, "width": { "type": "integer", "minimum": 1, "maximum": 8192 }, "height": { "type": "integer", "minimum": 1, "maximum": 8192 }, "durationFrames": { "type": "integer", "minimum": 1 }, "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "fromLayerId", "toLayerId", "durationFrames"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "type": { "enum": ["cut", "fade", "crossfade", "wipe"] }, "fromLayerId": { "$ref": "#/$defs/id" }, "toLayerId": { "$ref": "#/$defs/id" }, "durationFrames": { "type": "integer", "minimum": 0 }, "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "renderRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templateId", "templateVersion", "rendererProfile", "brandTokenSource", "brandTextMode", "networkPolicy", "publishReady"],
      "properties": {
        "templateId": { "$ref": "#/$defs/id" }, "templateVersion": { "$ref": "#/$defs/semver" }, "rendererProfile": { "type": "string", "minLength": 1, "maxLength": 128 }, "brandTokenSource": { "const": "docs/frontend/design-tokens.json" }, "brandTextMode": { "const": "deterministic" }, "networkPolicy": { "enum": ["offline", "provider-isolated"] }, "publishReady": { "const": false }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reference"],
      "properties": {
        "type": { "enum": ["legacy-render-manifest", "script-scene", "content-package", "manual"] }, "reference": { "type": "string", "minLength": 1, "maxLength": 512 }, "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requireAtProjectEdges"],
      "properties": {
        "defaultDisclaimer": { "type": "string", "minLength": 1, "maxLength": 500 }, "requireAtProjectEdges": { "type": "boolean" }
      }
    }
  }
}
