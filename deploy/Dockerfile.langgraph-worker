# Candidate-only image. No Render service or paid runtime is created by this file.
# Pinned existing Python image; scan image and dependencies in existing CI before deployment.
FROM python:3.14.7-slim@sha256:51dafde81dbdb6ebde285137a295cf18a47ca95234fe388a343719cb97305b3d
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    LANGSMITH_TRACING=false LANGCHAIN_TRACING_V2=false \
    LANGGRAPH_STRICT_MSGPACK=true
WORKDIR /opt/capital-ai-agent
COPY scripts/growth-agent/requirements.lock /tmp/requirements.lock
RUN python -m pip install --no-cache-dir -r /tmp/requirements.lock \
    && rm -f /tmp/requirements.lock \
    && mkdir -p /var/lib/capital-ai-agent/checkpoints /var/lib/capital-ai-agent/approvals \
    && chown -R 10001:10001 /var/lib/capital-ai-agent \
    && chmod 0700 /var/lib/capital-ai-agent /var/lib/capital-ai-agent/checkpoints /var/lib/capital-ai-agent/approvals
COPY --chown=10001:10001 scripts/growth-agent/ /opt/capital-ai-agent/
USER 10001:10001
STOPSIGNAL SIGTERM
# No HEALTHCHECK-based restart claim. Provider restart evidence required.
ENTRYPOINT ["python", "/opt/capital-ai-agent/isolated_worker_service.py"]
