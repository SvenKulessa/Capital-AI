# Candidate-only: NO service reference in render.yaml, no paid activation.
# Supply an immutable linux/amd64 python@sha256 digest after explicit resolution.
# Deliberately fail closed when PYTHON_BASE is omitted.
ARG PYTHON_BASE
FROM ${PYTHON_BASE}
LABEL org.opencontainers.image.source="https://github.com/SvenKulessa/Capital-AI" \
      capital-ai.component="offline-langgraph-worker" \
      capital-ai.activation="disabled-by-default"

# Reuse the glibc Python base needed by the pinned sqlite-vec manylinux wheel.
# Keep Debian package metadata for full vulnerability scanning.
RUN apt-get update \
    && apt-get upgrade --yes --no-install-recommends \
    && apt-get install --yes --only-upgrade --no-install-recommends libpcre2-8-0 libssl3t64 openssl openssl-provider-legacy \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    LANGSMITH_TRACING=false LANGCHAIN_TRACING_V2=false \
    LANGGRAPH_STRICT_MSGPACK=true \
    CAPITAL_AI_OFFLINE_WORKER_ENABLED=false

WORKDIR /app
COPY scripts/growth-agent/requirements.lock /app/scripts/growth-agent/requirements.lock
RUN python -m pip install --no-cache-dir --only-binary=:all: --disable-pip-version-check \
      -r /app/scripts/growth-agent/requirements.lock \
    && python -m pip check
COPY scripts/growth-agent /app/scripts/growth-agent
COPY AGENTS.md /app/AGENTS.md
COPY docs/architecture/EXECUTION-FIRST-LANGGRAPH.md /app/docs/architecture/EXECUTION-FIRST-LANGGRAPH.md
COPY docs/platform/LANGGRAPH-WORKER-READBACK-20261115.md /app/docs/platform/LANGGRAPH-WORKER-READBACK-20261115.md

# Candidate Render disk mount: /var/lib/capital-ai-agent. Requiring pre-owned
# 0700 directories fails closed if a future provider mount hides this tree.
RUN groupadd --gid 10001 capitalagent \
    && useradd --no-create-home --uid 10001 --gid 10001 capitalagent \
    && install -d -m 0700 -o 10001 -g 10001 /var/lib/capital-ai-agent \
    && install -d -m 0700 -o 10001 -g 10001 /var/lib/capital-ai-agent/checkpoints \
       /var/lib/capital-ai-agent/inbox /var/lib/capital-ai-agent/approvals
USER 10001:10001
STOPSIGNAL SIGTERM
# No HTTP port, provider actions, secrets or automatic submissions.
ENTRYPOINT ["python", "/app/scripts/growth-agent/worker_service.py", "--serve"]
