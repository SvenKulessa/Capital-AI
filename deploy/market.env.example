# Fill in locally; never commit real credentials. Market ingestion is fail-closed until Open-Data admission.
REDIS_URL=redis://:REPLACE_WITH_SECRET@127.0.0.1:6379
NATS_URL=nats://127.0.0.1:4222
NATS_APP_USER=capital-ai-market-runtime
NATS_APP_PASSWORD=REPLACE_WITH_SECRET
# Legacy local migration fallback only; production NATS uses the scoped user/password pair.
# NATS_TOKEN=REPLACE_WITH_LEGACY_SECRET
NATS_REPLICAS=1
MARKET_PUBSUB_ENABLED=true
MARKET_SYMBOLS=EUR/USD,EUR/JPY,EUR/CZK,EUR/DKK,EUR/GBP,EUR/HUF,EUR/PLN,EUR/RON,EUR/SEK,EUR/CHF,EUR/ISK,EUR/NOK,EUR/TRY,EUR/AUD,EUR/BRL,EUR/CAD,EUR/CNY,EUR/HKD,EUR/IDR,EUR/ILS
MARKET_QUOTES_ENABLED=false
MARKET_ECB_REFERENCE_RATES_ENABLED=false
