# Fill in locally; never commit real credentials. Market ingestion is fail-closed until Open-Data admission.
REDIS_URL=redis://:REPLACE_WITH_SECRET@127.0.0.1:6379
NATS_URL=nats://127.0.0.1:4222
NATS_TOKEN=REPLACE_WITH_SECRET
NATS_REPLICAS=1
MARKET_PUBSUB_ENABLED=true
MARKET_SYMBOLS=BTCUSDT,BTCUSD,AAPL
MARKET_QUOTES_ENABLED=false

# MARKET/TRUST-reviewed JSON array of canonical InstrumentSchema bindings (maximum 9000).
# A missing/invalid manifest serves no multi-asset quotes. Bind at runtime; do not invent fixtures.
MARKET_INSTRUMENT_MANIFEST=/run/market/instruments.json
