# Separate private infrastructure image; does not build or deploy Capital-AI.
FROM nats:2.15.1-alpine@sha256:2ae57dfba3063d5e25fecb75256118c0882a1a2d2cf7d0fba17a7c701df956f6 AS release-binary
ARG TARGETARCH
ARG TARGETVARIANT
COPY deploy/fetch-nats-release.sh /tmp/fetch-nats-release.sh
# Official 2.15.2 release binaries use Go 1.27.3 (CVE-2026-111943 fix); each archive is hash-pinned.
RUN sh /tmp/fetch-nats-release.sh

FROM nats:2.15.1-alpine@sha256:2ae57dfba3063d5e25fecb75256118c0882a1a2d2cf7d0fba17a7c701df956f6
ENV NATS_SERVER=2.15.2
LABEL org.opencontainers.image.version="2.15.2"
COPY --from=release-binary /out/nats-server /usr/local/bin/nats-server
COPY --from=release-binary /out/LICENSE /usr/share/licenses/nats-server/LICENSE
RUN apk add --no-cache su-exec=0.2-r3 'zlib>=1.3.2-r1' 'musl>=1.2.5-r13' 'musl-utils>=1.2.5-r13' \
    && addgroup -g 1000 nats && adduser -D -u 1000 -G nats nats
RUN test "$(nats-server --version)" = 'nats-server: v2.15.2'
COPY deploy/nats-server.conf /etc/nats/nats-server.conf
COPY --chmod=0555 deploy/nats-entrypoint.sh /usr/local/bin/capital-nats-entrypoint
# Root is used only to prepare the mounted disk; the server runs as UID/GID 1000.
USER 0:0
EXPOSE 4222
# Keep the broker's health contract private: verify that nats-server remains the
# running PID without opening an additional monitoring port.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["sh", "-ec", "pidof nats-server >/dev/null"]
ENTRYPOINT ["/usr/local/bin/capital-nats-entrypoint"]
