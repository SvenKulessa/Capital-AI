ARG PYTHON_BASE
ARG RUNTIME_BASE
FROM ${PYTHON_BASE} AS ffmpeg-build

ARG FFMPEG_VERSION=9.0.2
ARG FFMPEG_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl nasm perl xz-utils yasm \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp
RUN curl --proto '=https' --tlsv1.2 --fail --show-error --location \
      "https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.xz" -o ffmpeg.tar.xz \
    && printf '%s  %s\n' "${FFMPEG_SHA256}" ffmpeg.tar.xz | sha256sum -c - \
    && tar -xJf ffmpeg.tar.xz \
    && cd "ffmpeg-${FFMPEG_VERSION}" \
    && ./configure \
      --prefix=/opt/ffmpeg \
      --disable-autodetect \
      --disable-doc \
      --disable-debug \
      --disable-ffplay \
      --disable-network \
      --enable-shared \
      --disable-static \
    && make -j2 \
    && make install

ARG PYTHON_BASE
FROM ${PYTHON_BASE} AS deps-build

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN printf '%s\n' \
      'setuptools==84.0.0 --hash=sha256:51a52592b3b99e102b609654876bd65f19f999935166d1352678931132b0c670' \
      'wheel==0.48.0 --hash=sha256:3217dcc807155e45db462d7ef2431f5ddda0d7273b700d05a67b271ceb1287ab' \
      > /tmp/build-tools.txt \
    && python -m pip install --disable-pip-version-check --no-cache-dir --only-binary=:all: --require-hashes --requirement /tmp/build-tools.txt

COPY deploy/social-media/asr/whisper-runtime.generated.txt /tmp/whisper-runtime.txt
RUN python -m pip install \
      --disable-pip-version-check \
      --no-cache-dir \
      --no-build-isolation \
      --require-hashes \
      --target /opt/python \
      --requirement /tmp/whisper-runtime.txt

FROM ${RUNTIME_BASE} AS runtime

COPY --from=deps-build /opt/python /opt/python
COPY --from=ffmpeg-build /opt/ffmpeg /opt/ffmpeg

ENV PYTHONPATH="/opt/python" \
    PATH="/opt/ffmpeg/bin:${PATH}" \
    LD_LIBRARY_PATH="/opt/ffmpeg/lib"

USER 10001:10001
WORKDIR /work

ENTRYPOINT ["/usr/bin/python3"]
CMD ["-c","import whisper; print('whisper-worker-ready')"]
