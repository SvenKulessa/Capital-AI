# Local development only. Public market data remains fail-closed until MARKET admits an Open-Source + Open-Data source.
MARKET_SYMBOLS=BTCUSDT,BTCUSD,AAPL

# Backend-first Supabase Auth. Never expose SUPABASE_SECRET_KEY or AUTH_COOKIE_SIGNING_SECRET to VITE_.
PUBLIC_APP_ORIGIN=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
AUTH_COOKIE_SIGNING_SECRET=

# Fixed server-owned Telegram destination; exact Supabase auth.users UUIDs, comma-separated.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_SUBJECTS=

# Canonical scorer authority: public Capital-AI route -> Render private Finance service.
# Set this only to the Render Internal host on port 10000, e.g. http://<internal-host>:10000.
CAPITAL_AI_FINANCE_SCORER_PRIVATE_ORIGIN=
CAPITAL_AI_SCORER_ORIGIN=https://capital-ai.online
CAPITAL_AI_SCORER_ALLOW_SAME_ORIGIN=true

# Presentation rollout only. Does not grant provider/runner/production authority.
# Omit to show all modules; empty value hides them. Console remains owner-only.
# VITE_CAPITAL_ANALYSIS_UI_MODULES=components,sentiment,whales,console
