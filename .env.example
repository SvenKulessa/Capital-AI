# Local development only. Set real provider credentials in Render runtime secrets.
TWELVE_DATA_API_KEY=
POLYGON_API_KEY=
MARKET_SYMBOLS=BTCUSDT,BTCUSD,AAPL

# OIDC runtime configuration only; never use VITE_ prefixes for secrets.
PUBLIC_APP_ORIGIN=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Fixed server-owned Telegram destination; exact OIDC subjects, comma-separated.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_SUBJECTS=
