{
  "schema": "CAPITAL_AI_OPEN_SOURCE_MARKET_POLICY@1",
  "ownerDecisionAt": "2026-10-04",
  "scope": [
    "CAPITAL-AI-Web",
    "CAPITAL-AI-Mobile",
    "MARKET-data-path"
  ],
  "mode": "OPEN_SOURCE_AND_OPEN_DATA_ONLY",
  "softwarePolicy": {
    "openSourceRequired": true,
    "licenseEvidenceRequired": true,
    "allowedLicenseFamilies": [
      "MIT",
      "Apache-2.0",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "ISC",
      "GPL-3.0-only",
      "GPL-3.0-or-later",
      "AGPL-3.0-only",
      "AGPL-3.0-or-later",
      "LGPL-3.0-only",
      "LGPL-3.0-or-later",
      "MPL-2.0"
    ],
    "unknownLicense": "BLOCK"
  },
  "dataPolicy": {
    "openDataRequired": true,
    "allowedLicenses": [
      "CC0-1.0",
      "CC-BY-4.0",
      "CC-BY-SA-4.0",
      "ODbL-1.0"
    ],
    "nonCommercialLicenses": "BLOCK",
    "proprietaryCommercialContractAloneMayAuthorize": false,
    "publicApiAloneMayAuthorize": false,
    "paidSubscriptionAloneMayAuthorize": false,
    "unknownRights": "BLOCK"
  },
  "requiredUseCases": [
    "commercial_display",
    "commercial_derived_scoring",
    "cache_storage",
    "jetstream_replay_retention"
  ],
  "redistributionAndWhiteLabel": "SEPARATE_EXPLICIT_OPEN_DATA_RIGHTS_REQUIRED",
  "admittedSources": [],
  "blockedLegacyProviderPaths": [
    "binance",
    "kraken",
    "twelvedata",
    "polygon",
    "massive",
    "financialdatanet",
    "yfinance",
    "coingecko"
  ],
  "runtimePolicy": "NO_LIVE_PROVIDER_NETWORK_IO_UNTIL_ADMITTED_SOURCE_EXISTS",
  "credentials": "SERVER_SIDE_ONLY_IF_FUTURE_ADMITTED_SOURCE_REQUIRES_AUTH",
  "fixtures": "NON_PRODUCTION_ONLY"
}
