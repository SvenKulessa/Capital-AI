[
  {
    "id": 24259174,
    "name": "main-production-protection",
    "target": "branch",
    "source_type": "Repository",
    "source": "SvenKulessa/Capital-AI",
    "enforcement": "active",
    "conditions": {
      "ref_name": {
        "exclude": [],
        "include": [
          "~DEFAULT_BRANCH",
          "refs/heads/main"
        ]
      }
    },
    "rules": [
      {
        "type": "deletion"
      },
      {
        "type": "non_fast_forward"
      },
      {
        "type": "pull_request",
        "parameters": {
          "required_approving_review_count": 0,
          "dismiss_stale_reviews_on_push": true,
          "required_reviewers": [],
          "require_code_owner_review": false,
          "require_last_push_approval": false,
          "required_review_thread_resolution": true,
          "require_extra_approval_for_unattributed_changes": true,
          "allowed_merge_methods": [
            "merge",
            "squash"
          ]
        }
      },
      {
        "type": "required_status_checks",
        "parameters": {
          "strict_required_status_checks_policy": true,
          "do_not_enforce_on_create": false,
          "required_status_checks": [
            {
              "context": "Docker Security Gate",
              "integration_id": 15368
            },
            {
              "context": "Domain Governance",
              "integration_id": 15368
            }
          ]
        }
      },
      {
        "type": "required_linear_history"
      },
      {
        "type": "code_scanning",
        "parameters": {
          "code_scanning_tools": [
            {
              "tool": "CodeQL",
              "security_alerts_threshold": "medium_or_higher",
              "alerts_threshold": "errors_and_warnings"
            }
          ]
        }
      },
      {
        "type": "code_quality",
        "parameters": {
          "severity": "warnings"
        }
      }
    ],
    "node_id": "RRS_lACqUmVwb3NpdG9yec5NEcGszgFyKmY",
    "created_at": "2026-09-30T09:18:21.178-07:00",
    "updated_at": "2026-09-30T17:27:37.773-07:00",
    "bypass_actors": [],
    "current_user_can_bypass": "never",
    "_links": {
      "self": {
        "href": "https://api.github.com/repos/SvenKulessa/Capital-AI/rulesets/24259174"
      },
      "html": {
        "href": "https://github.com/SvenKulessa/Capital-AI/rules/24259174"
      }
    }
  }
]
