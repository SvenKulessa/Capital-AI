      ],
      "defaultStatus": "ALLOW_WITH_OBLIGATIONS"
    },
    "GPL": {
      "licenses": [
        "GPL-2.0-only",
        "GPL-2.0-or-later",
        "GPL-3.0-only",
        "GPL-3.0-or-later"
      ],
