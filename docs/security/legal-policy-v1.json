    }
  },
  "rules": [
    {
      "id": "BUILD_ONLY_NO_RUNTIME_REDISTRIBUTION",
      "when": {
        "usageClass": "BUILD_ONLY",
        "runtimeIncluded": false,
        "frontendIncluded": false,
        "distributedArtifact": false
      },
      "effect": "Do not require runtime redistribution obligations solely from build use."
    },
    {
      "id": "PUBLIC_GHCR_IS_DISTRIBUTION",
      "when": {
        "registry": "GHCR",
        "visibility": "public"
      },
      "effect": "Treat contained components as distributed copies."
    },
    {
      "id": "NETWORK_SERVICE_NOT_COPY_TRANSFER",
      "when": {
        "usageClass": "HOSTED_NETWORK_SERVICE",
        "copyTransferredToUser": false
      },
      "effect": "Do not infer GPLv2/v3 conveyance solely from network interaction; evaluate AGPL/network-copyleft separately."
    },
    {
      "id": "BROWSER_CODE_IS_DISTRIBUTED",
      "when": {
        "usageClass": "BUNDLED_FRONTEND"
      },
      "effect": "Apply distribution obligations to shipped browser code/assets/fonts/data."
    },
    {
      "id": "GPL_AGGREGATE_NOT_AUTOMATIC_APP_COPYLEFT",
      "when": {
        "licenseFamily": "GPL",
        "separateIndependentWork": true
      },
      "effect": "Do not extend GPL to independent aggregate components solely because they share a container/distribution medium."
    },
    {
      "id": "MPL_FILE_LEVEL",
      "when": {
        "licenseFamily": "MPL_2_0"
      },
      "effect": "Apply source obligations to Covered Software/Modifications, not automatically to unrelated files in a Larger Work."
    },
    {
      "id": "STATUTORY_ANALYSIS_RIGHTS",
      "when": {
        "legalBasis": [
          "UrhG_69d_3",
          "Directive_2009_24_Art5_3"
        ]
      },
      "effect": "Permit qualifying observe/study/test activity without treating it as redistribution authorization."
    },
    {
      "id": "INTEROPERABILITY_EXCEPTION_NARROW",
      "when": {
        "legalBasis": [
          "UrhG_69e",
          "Directive_2009_24_Art6"
        ]
      },
      "effect": "Require necessity, unavailable information, minimum scope, interoperability-only use and no substantially similar expression."
    }
  ],
  "evidenceFields": [
    "component",
    "exactVersion",
