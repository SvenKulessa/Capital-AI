{
  "schema": "CAPITAL_AI_APPLICATION_EXECUTION_PROMPT@1",
  "authority": {
    "source": "AGENTS.md",
    "contract": "SOLO_MAINTAINER_FLOW@2",
    "type": "NON_AUTHORIZING_CONTEXT",
    "permissionExpansion": false
  },
  "skillRegistry": ".agents/skills/registry.json",
  "domainPrompts": {
    "PRODUCT": "CAPITAL-AI-PRODUCT/domain.prompt.json",
    "MARKET": "CAPITAL-AI-MARKET/domain.prompt.json",
    "PLATFORM": "CAPITAL-AI-PLATFORM/domain.prompt.json",
    "TRUST": "CAPITAL-AI-TRUST/domain.prompt.json",
    "GROWTH": "CAPITAL-AI-GROWTH/domain.prompt.json"
  },
  "prompt": "Agieren Sie als Solo-Maintainer nach aktueller Root-AGENTS.md mit Fachperspektiven PRODUCT, MARKET, PLATFORM, TRUST und GROWTH. Lesen Sie die tatsächlich aktuellen Main-/PR-/Ruleset-Zustände. Bevorzugen Sie vorhandene PR-Branches, identifizieren Sie Datei-/Contract-Überschneidungen, reparieren Sie reproduzierbare Probleme, prüfen Sie vorhandene CI-/Security-Gates und mergen Sie nur SHA-gebunden bei vollständiger tatsächlicher Autorisierung. Verifizieren Sie nach Merge Runtime und Provider separat. Verwenden Sie keine erfundenen Zahlen, Rechte, Laufzeit- oder Monetarisierungsnachweise. Neue Scheduler, Cloud-Kosten oder Providerrechte entstehen nicht durch diese Anweisung.",
  "multiAgent": {
    "singlePermissionContext": true,
    "perspectives": [
      "ORCHESTRATOR",
      "DOMAIN_ENGINEER",
      "TRUST_SECURITY",
      "INDEPENDENT_QUALITY",
      "RELEASE_OBSERVER"
    ],
    "concurrentReadOnlyAnalysis": true,
    "serializedWrites": true,
    "maxRepairAttempts": 2
  },
  "workflow": [
    "READ_MAIN_AND_AGENTS",
    "CORRELATE_EXISTING_WORK",
    "SELECT_MINIMUM_SCOPE",
    "IMPLEMENT_AND_REPRODUCE",
    "POSITIVE_AND_NEGATIVE_TESTS",
    "VERIFY_CURRENT_HEAD_CI_AND_RULESET",
    "SQUASH_IF_AUTHORIZED",
    "READ_BACK_MAIN_AND_RUNTIME"
  ],
  "reportEvidence": [
    "mainSha",
    "headSha",
    "affectedContracts",
    "testResults",
    "ciRunIds",
    "securityAndRights",
    "productionReadback",
    "openBlockers",
    "nextAction"
  ],
  "constraints": [
    "NO_NEW_REQUIRED_CHECKS",
    "NO_NEW_SCHEDULERS",
    "NO_GUESSING_OF_PRODUCTION_EVIDENCE",
    "NO_RULESET_BYPASS",
    "NO_UNAUTHORIZED_PROVIDER_RIGHTS_OR_COSTS",
    "NO_CROSS_TENANT_DATA"
  ],
  "metrics": {
    "labels": [
      "PR_MERGE_COUNT",
      "MEDIAN_PR_CYCLE_TIME",
      "REQUIRED_CHECK_SUCCESS_RATE"
    ],
    "sources": [
      "GitHub PR created_at/merged_at",
      "GitHub check runs",
      "GitHub main commit history"
    ],
    "unknown": "NOT_PROVEN",
    "noInventedGains": true
  },
  "tenPrEfficiencyMilestone": {
    "schema": "CAPITAL_AI_TEN_PR_EFFICIENCY_MILESTONE@1",
    "sourcePr": 852,
    "appliesAfter": "2026-11-20 owner authorization; exact time is NOT_PROVEN",
    "requiredVerifiedMerges": 10,
    "excludedPullRequests": [
      850
    ],
    "inclusion": "Only distinct actually merged PRs after owner authorization with verified GitHub main-merge, required-check, SHA and domain evidence; do not count a drafted or merely green PR",
    "exclude": "Draft, unmerged, superseded, pre-authorization, missing or unverifiable PR/CI evidence",
    "sources": [
      "GitHub PR created_at and merged_at",
      "GitHub main merge commit SHA and ancestry",
      "GitHub Actions required-check conclusions and run IDs bound to the merge candidate",
      "Canonical .agents/skills/registry.json domain mapping"
    ],
    "evidenceFields": [
      "prNumber",
      "domain",
      "createdAt",
      "mergedAt",
      "mainMergeSha",
      "testedHeadSha",
      "requiredCheckRunIds",
      "requiredCheckConclusions",
      "githubSourceUrls"
    ],
    "metrics": [
      "PR lead time (created_at to merged_at)",
      "PR cycle time (first commit to merge, only when timestamps evidenced)",
      "CI pass ratio with explicit denominator",
      "regression/rollback count only when evidence exists"
    ],
    "groupBy": "domain",
    "missingData": "NOT_PROVEN",
    "publication": "Create responsive accessible seven-color homepage graphic only after 10 individually VERIFIED qualifying PR merges; preserve existing Hero, Globe and Hub. No automatic publishing.",
    "permissionExpansion": false,
    "createsRequiredChecks": false,
    "createsScheduler": false,
    "noInventedEfficiencyClaims": true
  },
  "solo2DomainLoop": {
    "schema": "CAPITAL_AI_SOLO2_DOMAIN_LOOP@1",
    "kind": "NON_AUTHORIZING_EXECUTION_PROFILE",
    "authority": "AGENTS.md",
    "contract": "SOLO_MAINTAINER_FLOW@2",
    "repository": "SvenKulessa/Capital-AI",
    "projectIsolation": "STRICT",
    "domainRegistry": ".agents/skills/registry.json",
    "domainProfiles": "domainPrompts",
    "orchestrator": "scripts/growth-agent/auto_loop.py",
    "offlineResearch": "scripts/growth-agent/agent_platform.py",
    "durableCheckpoints": "scripts/growth-agent/checkpoint_store.py",
    "schedulerPolicy": "REUSE_EXISTING_ONLY",
    "permissionExpansion": false,
    "runtimeActivation": "NOT_PROVEN",
    "decisionSequence": [
      "LOAD_LIVE_AGENTS_MAIN_AND_SCOPED_SKILLS",
      "RECONCILE_EXISTING_PRS_AND_CONTRACT_OVERLAP",
      "PRIORITIZE_OWNER_SCOPE_AND_P0_RISKS",
      "SELECT_ONE_MUTATING_SCOPE",
      "REPRODUCE_AND_IMPLEMENT_MINIMAL_FIX",
      "EXECUTE_TARGETED_POSITIVE_NEGATIVE_TESTS",
      "VERIFY_REAL_CURRENT_BASE_HEAD_CI_RULESETS",
      "MERGE_ONLY_IF_EXISTING_DELEGATION_AND_CHECKS_PROVEN",
      "READBACK_MAIN_IMAGE_DEPLOYMENT_AND_RUNTIME_SEPARATELY"
    ],
    "orchestration": {
      "readOnlyAnalysisMayParallelize": true,
      "writesSerialized": true,
      "oneMutatingScopePerRepository": true,
      "crossDomainSkillsOnDemand": true,
      "independentQualityPerspective": true,
      "trustPerspectiveOnAffectedBoundaries": true,
      "maxDistinctRepairAttempts": 2,
      "reuseStillValidEvidenceOnlyOnSameScopeAndSha": true,
      "preferExistingPR": true,
      "blockedIndependentWorkMayContinue": true
    },
    "stateSemantics": {
      "UNKNOWN": "NOT_PROVEN_OR_BLOCKED",
      "STALE": "REVALIDATE",
      "FAILED": "BLOCKED",
      "PENDING": "WAIT",
      "success": "REQUIRE_SOURCE_BOUND_EVIDENCE"
    },
    "evidenceLevels": [
      "CONTROL_PRESENT",
      "CONTROL_TESTED",
      "CI_VERIFIED",
      "PRODUCTION_VERIFIED"
    ],
    "claims": {
      "projectPolicyChanges": false,
      "grantsToolAccess": false,
      "createsRequiredChecks": false,
      "createsNewScheduler": false,
      "allowsManualDeployment": false,
      "allowsUnauthorizedProviderActivation": false
    },
    "limitations": "Declarative chat/domain configuration only; no claim of live worker activation, hosted scheduler wiring, or completed CI."
  }
}
